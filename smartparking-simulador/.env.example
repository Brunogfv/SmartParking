# URL da API do SmartParking
API_URL=http://localhost:3000

# Modo padrao quando nenhum argumento for passado
# Opcoes: aleatorio, sequencial, manual, carga, cenario
MODO=aleatorio

# Intervalo entre envios (em milissegundos)
INTERVALO_MS=5000

# Modo carga: total de POSTs e intervalo entre eles (ms)
TOTAL_CARGA=100
INTERVALO_CARGA=100

# Modo cenario: tempo esperando com o estacionamento LOTADO (ms)
ESPERA_LOTADO_MS=5000

# Exibir resumo parcial a cada N envios
CICLOS_RESUMO=10

# MAC do ESP32 da maquete (opcional - exibido no painel de detalhes)
MAC_ESP32=
